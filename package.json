{
  "name": "flaxia-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A Flaxia-flavoured browser IDE with Monaco and container2wasm Linux",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "build:linux": "node scripts/build-linux-image.mjs",
    "verify:linux": "node scripts/verify-linux-image.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:linux": "node scripts/linux-gcc.mjs",
    "serve:dist": "node scripts/serve-dist.mjs dist",
    "fetch:linux-demo": "node scripts/fetch-linux-demo.mjs",
    "test:csp": "node scripts/csp-smoke.mjs",
    "fetch:linux-full": "node scripts/fetch-linux-demo.mjs",
    "fetch:linux-lite": "node scripts/fetch-linux-lite.mjs",
    "test:net": "node scripts/linux-net.mjs",
    "test:manifest": "node scripts/manifest-fallback.mjs",
    "test:exec": "node scripts/linux-exec.mjs",
    "test:session": "node scripts/session-test.mjs"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "fflate": "^0.8.3",
    "lucide": "^1.67.0",
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^24.0.0",
    "fake-indexeddb": "^6.2.7",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22"
  }
}
